pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Icon path table generated by scripts/gen_icons.py into icons.json. Loaded through a
// watched FileView so regenerating it takes effect without restarting the shell.
Singleton {
    id: paths

    property var filled: ({})
    property var outlined: ({})

    FileView {
        path: Quickshell.shellPath("Components/icons.json")
        blockLoading: true
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            const data = JSON.parse(text());
            paths.filled = data.filled;
            paths.outlined = data.outlined;
        }
    }
}
